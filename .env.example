DISCORD_TOKEN=
# OAuth dashboard (DASHBOARD_BASE_URL must be the public HTTPS origin).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DASHBOARD_BASE_URL=https://bot.example.com
DASHBOARD_SESSION_SECRET=replace-with-a-stable-random-secret-of-at-least-32-bytes
PUBLIC_SITE_URL=https://esil.life
PORT=10000
# Optional: used to scope global slash commands to one guild while developing.
DISCORD_GUILD_ID=

#Lavalink 4.2.2
# docker-compose forwards this bot password to Lavalink as LAVALINK_SERVER_PASSWORD.
LAVALINK_ADDRESS=127.0.0.1:2333
LAVALINK_PASSWORD=change-this-password
LAVALINK_TLS=false
APPLE_MUSIC_COUNTRY=RU

 AI providers are optional. At least one key is needed for AI responses.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=deepseek-chat
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Vivian

DATABASE_URL=sqlite://data/vivian.db
AI_HISTORY_TURNS=12
AI_REPLY_LANGUAGE=ru
RUST_LOG=info

